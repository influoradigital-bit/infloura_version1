{
  "_about": "Shared by CreatorOwnCaptionTest (Java) and influora-ai tests/tools/test_content_patterns_real_payload.py: the two caption cleaners must give exactly these results (ADR wiki/decisions/2026-09-26-creator-own-caption-to-meera.md). Expected values are written by hand, never generated by either cleaner.",
  "cases": [
    {
      "name": "second line never sent",
      "input": "Morning routine\nSecond line",
      "expected": "Morning routine"
    },
    {
      "name": "leading blank lines are not a line",
      "input": "\n \n\tReal first line\nnext",
      "expected": "Real first line"
    },
    {
      "name": "a handle-only first line sends nothing, never line 2",
      "input": "@brand\nMy monsoon skincare routine",
      "expected": null
    },
    {
      "name": "a spacer first line sends nothing, never line 2",
      "input": ".\nReal line",
      "expected": null
    },
    {
      "name": "blank caption",
      "input": "  \n\t ",
      "expected": null
    },
    {
      "name": "C1 controls (incl. CSI U+009B) become spaces",
      "input": "Hi\u0090there\u009b31m",
      "expected": "Hi there 31m"
    },
    {
      "name": "format characters vanish without splitting the word",
      "input": "zero\u200bwidth \u202eflip",
      "expected": "zerowidth flip"
    },
    {
      "name": "a zero-width space cannot hide a handle",
      "input": "@\u200bhandle rocks",
      "expected": "rocks"
    },
    {
      "name": "a joiner after ASCII cannot hide a link",
      "input": "linktr\u200d.ee/me hi",
      "expected": "hi"
    },
    {
      "name": "ZWNJ inside a Devanagari word is kept",
      "input": "\u0915\u094d\u200c\u0937 word",
      "expected": "\u0915\u094d\u200c\u0937 word"
    },
    {
      "name": "ZWJ inside an emoji is kept",
