# Copy to .env and fill in values (IDE / docker-compose can load these)

SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Required by CreatorCouponService (influora.api.public-url, @Value has no default) — boot fails
# without it, no matter the profile.
INFLUORA_API_PUBLIC_URL=http://localhost:8080

# W3-1 — SPA origin used to build absolute links embedded in transactional emails (password reset).
# vite.config.ts serves on :3000 by default (not the framework-default 5173 this used to say).
INFLUORA_WEB_BASE_URL=http://localhost:3000

# application.yml's influora.cors.allowed-origins default is also :5173-only — override so the
# actual :3000 dev frontend isn't rejected by CORS.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

JWT_ACCESS_SECRET=change-me-to-a-random-string-at-least-32-characters-long
JWT_REFRESH_SECRET=change-me-another-random-string-at-least-32-chars

# Meera SSE stream token — distinct key from the user JWT secrets above (blast-radius isolation)
MEERA_STREAM_SIGNING_SECRET=change-me-another-random-string-at-least-32-chars
MEERA_STREAM_TOKEN_TTL_SECONDS=60

# /internal/meera/* mesh auth — distinct keys from every other secret in this file.
# INTERNAL_SERVICE_TOKEN_SECRET verifies the Python-issued X-Meera-Service-Token JWT
# (aud=influora-internal, iss=meera-python, exp<=60s). INTERNAL_REQUEST_HMAC_SECRET verifies the
# X-Meera-Signature HMAC over every internal request body (replay/tamper protection).
INTERNAL_SERVICE_TOKEN_SECRET=change-me-another-random-string-at-least-32-chars
INTERNAL_REQUEST_HMAC_SECRET=change-me-another-random-string-at-least-32-chars
INTERNAL_REQUEST_CLOCK_SKEW_SECONDS=30

# MySQL 8
SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/influora?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=influora
SPRING_DATASOURCE_PASSWORD=influora

# Cloudflare R2 — https://dash.cloudflare.com → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_r2_access_key_id
R2_SECRET_ACCESS_KEY=your_r2_secret_access_key
R2_BUCKET_NAME=influora-dev
R2_ENDPOINT=https://your_cloudflare_account_id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://r2.influora.com
R2_PRESIGN_EXPIRY_SECONDS=900
R2_MAX_VIDEO_BYTES=524288000

# D14 — Influora's own tax identity (supplier-of-record on subscription + commission invoices).
# gstin placeholder; CompanyTaxStartupValidator (INV-2) refuses to boot prod on a blank,
# still-placeholder, or malformed GSTIN. No STATE_CODE var -- deleted (INV-2), it had zero callers.
INFLUORA_LEGAL_NAME=Influora Technologies Pvt. Ltd.
INFLUORA_COMPANY_GSTIN=REPLACE_WITH_REAL_GSTIN
INFLUORA_COMPANY_ADDRESS=REPLACE_WITH_REGISTERED_ADDRESS

# MSG91 — Email OTP uses token-auth + Email template (NOT SMS auth-key). See docs/MSG91-EMAIL-OTP.md
MSG91_ENABLED=true
MSG91_AUTH_KEY=
MSG91_SENDER_ID=INFLRA
MSG91_ROUTE=4
MSG91_WIDGET_ID=
MSG91_TOKEN_AUTH=
MSG91_EMAIL_DOMAIN=
MSG91_FROM_EMAIL=
MSG91_FROM_NAME=Influora
MSG91_EMAIL_TEMPLATE_ID=otpman
MSG91_EMAIL_TRANSACTIONAL_TEMPLATE_ID=
MSG91_EMAIL_TEMPLATE_OTP_VARIABLE=otp
MSG91_EMAIL_TRANSACTIONAL_LINK_VARIABLE=magic_link
MSG91_EMAIL_COMPANY_NAME=Influora
MSG91_OTP_TEMPLATE_ID=
MSG91_WELCOME_TEMPLATE_ID=
