# Copy to .env.local and set VITE_API_MODE=live to use Spring Boot backend

VITE_API_MODE=live
VITE_API_BASE_URL=http://localhost:8080/api/v1

# Python AI service SSE stream URL (returned by Spring in sendTurn response)
# Only used for direct browser->Python SSE connection
VITE_MEERA_STREAM_URL=https://ai.influora.internal

# Admin live-pulse WebSocket (src/admin/services/websocket.ts). Default OFF —
# no backend WS endpoint exists yet (B1 phase 1, 2026-07-15). The admin panel
# works fully without it via REST polling (usePulseData). Only set to "true"
# once Vikram ships the Phase 2 backend endpoint.
VITE_ADMIN_WS_ENABLED=false

# Product walkthrough video, shown at the top of /brand/how-it-works and
# /creator/how-it-works and advertised by the first-run checklist.
# Leave unset and each role plays the film we ship in public/videos/.
# Set to an EMPTY value to switch a film off — no empty player, no "coming soon" box.
# Accepted: YouTube, Vimeo, or an https .mp4/.webm/.mov on *.influora.in.
# Self-hosted films live in public/videos/ and are served from the site root.
# VITE_WALKTHROUGH_VIDEO_BRAND_URL=https://influora.in/videos/campaign-lifecycle.mp4
# VITE_WALKTHROUGH_VIDEO_CREATOR_URL=https://influora.in/videos/creator-lifecycle.mp4
# VITE_WALKTHROUGH_VIDEO_BRAND_CAMPAIGN_URL=https://influora.in/videos/how-to-create-a-campaign.mp4
