{"id": "ase-001-shopify-spa-json-ld-graph", "input": {"raw_html": "<html><head><script type=\"application/ld+json\">{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":\"WebSite\",\"name\":\"Lumos Skincare\"},{\"@type\":\"Product\",\"name\":\"Retinal Night Serum\",\"offers\":{\"@type\":\"Offer\",\"price\":\"899.00\",\"priceCurrency\":\"INR\"}},{\"@type\":\"Product\",\"name\":\"Niacinamide 10% Moisturizer\",\"offers\":{\"@type\":\"Offer\",\"price\":649,\"priceCurrency\":\"INR\"}}]}</script></head><body><div id=\"root\"></div></body></html>"}, "expected": {"scraped_products": [{"name": "Retinal Night Serum", "price": 899.0, "currency": "INR"}, {"name": "Niacinamide 10% Moisturizer", "price": 649.0, "currency": "INR"}], "source": "json_ld", "note": "sparse/near-empty visible body (SPA mount div), but @graph JSON-LD carries the real catalog -- the exact case P1-B recovers without a browser"}}
{"id": "ase-002-static-site-single-product", "input": {"raw_html": "<html><head><title>Earthful Organics</title></head><body><p>Earthful Organics -- certified organic staples from Indian farms.</p><script type=\"application/ld+json\">{\"@type\":\"Product\",\"name\":\"Cold-Pressed Groundnut Oil\",\"offers\":{\"@type\":\"Offer\",\"price\":\"550\",\"priceCurrency\":\"INR\"}}</script></body></html>"}, "expected": {"scraped_products": [{"name": "Cold-Pressed Groundnut Oil", "price": 550.0, "currency": "INR"}], "source": "json_ld", "note": "plain static HTML with visible text AND JSON-LD -- baseline case, no render needed either way"}}
{"id": "ase-003-no-structured-data", "input": {"raw_html": "<html><head><title>A Brand</title></head><body><div id=\"root\"></div><script src=\"/bundle.js\"></script></body></html>"}, "expected": {"scraped_products": [], "source": "none", "note": "pure client-rendered SPA with zero schema.org/OpenGraph signal -- must fall back to today's all-inferred behavior, never crash or fabricate a product"}}
{"id": "ase-004-item-list-with-aggregate-offer", "input": {"raw_html": "<script type=\"application/ld+json\">{\"@type\":\"ItemList\",\"itemListElement\":[{\"@type\":\"Product\",\"name\":\"Chai Blend 250g\",\"offers\":{\"@type\":\"Offer\",\"price\":299,\"priceCurrency\":\"INR\"}},{\"@type\":\"Product\",\"name\":\"Chai Blend 500g\",\"offers\":{\"@type\":\"AggregateOffer\",\"lowPrice\":499,\"price\":499,\"priceCurrency\":\"INR\"}}]}</script>"}, "expected": {"scraped_products": [{"name": "Chai Blend 250g", "price": 299.0, "currency": "INR"}, {"name": "Chai Blend 500g", "price": 499.0, "currency": "INR"}], "source": "json_ld", "note": "category-page ItemList wrapper, one entry using AggregateOffer instead of Offer -- common on collection pages"}}
{"id": "ase-005-malformed-block-then-valid-block", "input": {"raw_html": "<script type=\"application/ld+json\">{not valid json at all</script><script type=\"application/ld+json\">{\"@type\":\"Product\",\"name\":\"Still Recovered\",\"offers\":{\"@type\":\"Offer\",\"price\":100,\"priceCurrency\":\"INR\"}}</script>"}, "expected": {"scraped_products": [{"name": "Still Recovered", "price": 100.0, "currency": "INR"}], "source": "json_ld", "note": "one malformed JSON-LD script tag must not prevent recovering a later well-formed block on the same page"}}
{"id": "ase-006-opengraph-only", "input": {"raw_html": "<html><head><meta property=\"og:title\" content=\"VoltEdge 65W GaN Charger\" /><meta property=\"product:price:amount\" content=\"1799\" /><meta property=\"product:price:currency\" content=\"INR\" /></head><body><div id=\"app\"></div></body></html>"}, "expected": {"scraped_products": [{"name": "VoltEdge 65W GaN Charger", "price": 1799.0, "currency": "INR"}], "source": "opengraph", "note": "no JSON-LD at all, OpenGraph product tags are the only structured signal -- common on lighter Wix/custom storefronts"}}
{"id": "ase-007-microdata-only", "input": {"raw_html": "<div itemscope itemtype=\"https://schema.org/Product\"><span itemprop=\"name\">Brahmi Focus Drops</span><span itemprop=\"offers\" itemscope itemtype=\"https://schema.org/Offer\"><span itemprop=\"price\" content=\"699\">Rs 699</span><span itemprop=\"priceCurrency\" content=\"INR\">INR</span></span></div>"}, "expected": {"scraped_products": [{"name": "Brahmi Focus Drops", "price": 699.0, "currency": "INR"}], "source": "microdata", "note": "legacy microdata markup, no JSON-LD/OpenGraph at all -- the last-resort fallback"}}
{"id": "ase-008-json-ld-wins-over-opengraph", "input": {"raw_html": "<head><meta property=\"og:title\" content=\"Should Not Win\" /><script type=\"application/ld+json\">{\"@type\":\"Product\",\"name\":\"JSON-LD Wins\",\"offers\":{\"@type\":\"Offer\",\"price\":250,\"priceCurrency\":\"INR\"}}</script></head>"}, "expected": {"scraped_products": [{"name": "JSON-LD Wins", "price": 250.0, "currency": "INR"}], "source": "json_ld", "note": "a page with BOTH JSON-LD and OpenGraph must prefer the richer JSON-LD signal and not also append the OG guess"}}
{"id": "ase-009-non-product-json-ld-ignored", "input": {"raw_html": "<script type=\"application/ld+json\">{\"@type\":\"Organization\",\"name\":\"Sage Digital\",\"url\":\"https://example.test\"}</script><script type=\"application/ld+json\">{\"@type\":\"BreadcrumbList\",\"itemListElement\":[]}</script>"}, "expected": {"scraped_products": [], "source": "none", "note": "Organization/BreadcrumbList JSON-LD is common but is NOT a product -- must not be misread as one, and must not fabricate a product from unrelated schema.org types"}}
{"id": "ase-010-multiple-offers-first-priced-one-wins", "input": {"raw_html": "<script type=\"application/ld+json\">{\"@type\":\"Product\",\"name\":\"Squat-Proof Leggings\",\"offers\":[{\"@type\":\"Offer\",\"price\":null,\"priceCurrency\":\"INR\"},{\"@type\":\"Offer\",\"price\":1599,\"priceCurrency\":\"INR\"}]}</script>"}, "expected": {"scraped_products": [{"name": "Squat-Proof Leggings", "price": 1599.0, "currency": "INR"}], "source": "json_ld", "note": "offers as an array with a null-priced variant listed first -- must skip to the first offer that actually carries a price instead of giving up"}}
