# Influora AI service (Meera reasoner) — copy to .env for local dev.
# NO REAL SECRETS COMMITTED HERE. A secrets manager injects these as env vars
# in every non-local environment. Blast-radius isolation (Kabir guardrail #6):
# this service holds ONLY the values below — never Razorpay keys, never DB
# credentials, never the user JWT signing key.

APP_ENV=dev
LOG_LEVEL=INFO

# --- LLM provider keys (secrets-manager injected in prod) ---
# Get from: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=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
CLAUDE_MODEL=claude-sonnet-4-5-20250929

# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy-REPLACE_WITH_YOUR_GEMINI_KEY

# Get from: https://dashboard.sarvam.ai/
SARVAM_API_KEY=sk_77nef74k_vJkSsK9wq7cnaZLoKDTxhpKi

# --- Spring auth integration ---
# Production: point at Spring's rotating JWKS endpoint (asymmetric keys, honors `kid`).
SPRING_JWKS_URL=https://api.influora.internal/.well-known/jwks.json
SPRING_JWKS_CACHE_SECONDS=300
SPRING_JWT_ISSUER=influora-api
SERVICE_TOKEN_AUD=influora-internal
STREAM_TOKEN_AUD=meera-stream

# Local-dev-only fallback when SPRING_JWKS_URL is unreachable (symmetric secret,
# HS256). NEVER set this in any shared/staging/prod environment.
# MUST match Spring's `influora.meera.stream.signing-secret`
# (MEERA_STREAM_SIGNING_SECRET in influora-api/src/main/resources/application.yml)
# exactly, or every incoming stream-token verification fails closed with 401.

DEV_SHARED_JWT_SECRET=dev-meera-stream-secret-change-in-production-min-32-chars

# --- Internal request signing (Python -> Spring /internal/meera/*) ---
# HMAC(sharedInternalHmacKey, method+path+sha256(body)+timestamp+nonce) -> X-Meera-Signature
# MUST match Spring's `influora.internal-service-token.hmac-signing-secret`
# (INTERNAL_REQUEST_HMAC_SECRET in application.yml) exactly, or every
# Python -> Spring internal call is rejected as SIGNATURE_MISMATCH.
INTERNAL_HMAC_KEY=dev-internal-request-hmac-secret-change-in-production-min-32-chars
INTERNAL_HMAC_KEY_ID=v1

# --- X-Meera-Service-Token minting (Python -> Spring /internal/meera/*) ---
# Signs the service-token JWT itself (iss=meera-python, aud=influora-internal,
# HS256, exp-iat<=60s -- Spring enforces the 60s ceiling regardless of what we
# request). MUST be a DIFFERENT secret from INTERNAL_HMAC_KEY above (that one
# signs the request HMAC, this one signs the bearer token) and MUST match
# Spring's `influora.internal-service-token.signing-secret`
# (INTERNAL_SERVICE_TOKEN_SECRET in application.yml) exactly, or Spring
# rejects every service token with a signature error before any provider call.
SERVICE_TOKEN_SIGNING_KEY=dev-internal-service-token-secret-change-in-production-min-32-chars

# --- Spring internal base URL (mesh-internal, not internet-routable) ---
# MUST include the /api/v1 context-path (server.servlet.context-path in
# influora-api's application.yml applies to every controller, including
# MeeraInternalController's /internal/meera/* routes) or every internal
# call 404s.
# For local dev, use localhost; for docker-compose, use the service name.
SPRING_INTERNAL_BASE_URL=http://localhost:8080/api/v1

# --- CORS for the browser's direct SSE call to /chat (app/main.py) ---
# Empty (the default) means CORSMiddleware never gets added at all -- the browser's preflight
# OPTIONS to /chat gets a bare 405 and the real POST never sends. Must match the frontend's
# actual origin exactly (no "*" -- required for a request carrying an Authorization header).
MEERA_ALLOWED_ORIGINS=http://localhost:3000

# --- SSRF guard (analyze-site egress control) ---
SSRF_MAX_REDIRECTS=2
SSRF_MAX_RESPONSE_BYTES=5000000
SSRF_FETCH_TIMEOUT_SECONDS=15

# --- TrendSpark LLM Recovery Tagger (n8n -> POST /internal/trendspark/tag) ---
# The n8n daily trend-pull (trendspark/n8n/trend-pull-workflow.json) calls this
# endpoint for trends its deterministic keyword tagger dropped. Auth is a STATIC
# shared secret (deliberate exception to the service-token rule — see the header
# of app/routes/trend_tag.py). This value MUST match the n8n workflow's
# $env.TREND_TAG_INGEST_SECRET byte-for-byte, or every recovery call gets 401.
# Empty => the endpoint fails closed with 503 (never runs open). Rotate quarterly.
TREND_TAG_INGEST_SECRET=dev-trend-tag-ingest-secret-change-in-production-min-32-chars
# Model for the recovery pass (defaults to TRENDSPARK_MODEL, a cheap Haiku class).
TREND_TAG_MODEL=claude-haiku-4-5-20251001
# Untrusted trend_text is truncated to this many chars before the model call.
TREND_TAG_MAX_TREND_TEXT_CHARS=200
# Max themes accepted from the model (closed-vocab validated).
TREND_TAG_MAX_THEMES=6
# Output token ceiling per recovery call (JSON is tiny).
TREND_TAG_MAX_TOKENS=80
# Per-process fixed-window rate limit (control #3). <=0 disables (tests only).
TREND_TAG_RATE_LIMIT_PER_MINUTE=120

# --- Tool loop ---
TOOL_LOOP_MAX_ITERATIONS=6

# Output-token ceiling per Meera chat turn. A BACKSTOP, not the reply-length
# mechanism -- persona.py's HARD LENGTH LIMIT rails shape reply length; this
# just has to be wide enough that a legitimate tool call (e.g. create_campaign,
# ~245-365 output tokens of JSON) never gets truncated mid-input_json_delta.
# P1 BLANK TURN fix (2026-07-24, wiki/ai-review/meera-blank-turn-ai-review.md):
# this was previously UNSET here, silently inheriting config.py's old 384
# default, which sat exactly on create_campaign's truncation boundary and
# caused ~28% of Meera turns to go completely blank. PIN this explicitly --
# never let it silently fall back to a code default again.
MEERA_CHAT_MAX_TOKENS=1536
# Wider one-shot ceiling for the single server-side retry after a truncated
# tool-planning turn comes back empty (F2, app/tools/loop.py). Not spoken, so
# the narration-length rationale above does not apply to it.
MEERA_CHAT_MAX_TOKENS_RETRY=2048

# --- SSE ---
SSE_HEARTBEAT_SECONDS=15
