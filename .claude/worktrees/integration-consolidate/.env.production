# Production build defaults (W0-2).
# VITE_* vars are bundled into the client and are PUBLIC by definition — never
# put secrets (API keys, tokens) here. This file only pins the API mode/base URL
# so a production build can never silently ship in mock mode.
#
# vite.config.ts fails the build (`npm run build`) if VITE_API_MODE !== "live"
# or VITE_API_BASE_URL is unset/points at localhost when mode=production, so a
# misconfigured or deleted value here breaks the build instead of shipping a
# prod bundle where login throws MockAuthDisabledError (src/lib/api.ts).

VITE_API_MODE=live

# Placeholder — replace with the real deployed influora-api URL before release.
VITE_API_BASE_URL=https://api.influora.com/api/v1
