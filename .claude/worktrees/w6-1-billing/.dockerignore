# Frontend Docker build context (see ./Dockerfile) — keeps the context small and excludes the
# backend services, docs, and generated artifacts that the Vite build never touches.
node_modules
dist
.git
.github
.claude
.cursor
.tools

# Other repo members' services — irrelevant to the frontend image, each has its own Dockerfile
# + .dockerignore.
influora-api
influora-ai

# Docs / planning / large working files — not needed inside the image, and SHARED_CONTEXT.md /
# TASK_INBOX.md are large enough to noticeably slow down `docker build`'s context upload.
wiki
docs
screenshots
scratch_jwks_repro
*.md
*.docx

# Local-only env files — VITE_* values are supplied via --build-arg, never baked in from a
# committed/local .env file (see Dockerfile header comment).
.env.local
.env.local.example

# Build/type-check caches, logs.
tsconfig.tsbuildinfo
*.log
