# Cloudflare Pages / Netlify-style static headers (A-GA-2 / M-K6-C2-3)
#
# ⚠️ THIS FILE IS NOT WHAT PRODUCTION SERVES. Editing it changes nothing on influora.in.
#
# [Kabir H-5] Every real deploy serves the SPA from nginx — deploy/hostinger/Caddyfile and
# deploy/utho/Caddyfile both `reverse_proxy frontend:80`, and that container's config is
# docker/nginx.conf.template. This file's syntax is only understood by Cloudflare Pages and
# Netlify, so it applies to preview deploys there and nowhere else.
#
# That gap was not theoretical: the per-path festival CSP below was added here in phase 6 and
# never reached a browser, so the sponsor Meta pixel was blocked in production the whole time the
# landing page advertised it as working. The real per-path policy now lives in the
# `map $uri $influora_csp` block in docker/nginx.conf.template.
#
# KEEP THE TWO IN SYNC. If you change a CSP directive here, change it there — and note that the
# nginx one is the only one that matters. Do NOT "fix" a production CSP problem by editing this
# file; you will see no effect and conclude the wrong thing.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://checkout.razorpay.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: http://localhost:* http://127.0.0.1:* ws: wss: https://api.razorpay.com https://lumberjack.razorpay.com; frame-src https://api.razorpay.com https://checkout.razorpay.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # microphone=(self) -- Meera's voice input (useVoiceInput -> getUserMedia) needs mic access
  # from this app's own origin. This was blanket-disabled (microphone=()), which would have
  # permanently broken voice input the moment this header actually took effect on a real deploy
  # (Netlify/Cloudflare Pages honor public/_headers; Vite's local dev server does not, which is
  # why this wasn't the cause of any mic bug reproduced against localhost).
  Permissions-Policy: geolocation=(), microphone=(self), camera=()

# T-FESTIVALBOX-0905 phase 6 — scoped ONLY to /festival-box/*, deliberately not the sitewide /*
# block above. The Festival Box edition page conditionally loads a sponsor's Meta Pixel (only
# after the visitor accepts the on-page consent bar — see PageConsentBar.tsx / the pixel effect
# in festival-box-edition.tsx), which needs connect.facebook.net in script-src and
# www.facebook.com in img-src/connect-src. If some OTHER page ever needs a third-party script,
# the fix is a new path-scoped block here for THAT path — never widening this block's path glob
# or the sitewide /* block. The rest of influora.in must stay tracker-free.
/festival-box/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://checkout.razorpay.com https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https: https://www.facebook.com; font-src 'self' data:; connect-src 'self' https: http://localhost:* http://127.0.0.1:* ws: wss: https://api.razorpay.com https://lumberjack.razorpay.com https://www.facebook.com; frame-src https://api.razorpay.com https://checkout.razorpay.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Permissions-Policy: geolocation=(), microphone=(self), camera=()
