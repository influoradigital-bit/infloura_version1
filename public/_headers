# Cloudflare Pages / Netlify-style static headers (A-GA-2 / M-K6-C2-3)
#
# ⚠️ THIS FILE IS NOT WHAT PRODUCTION SERVES. Editing it changes nothing on influora.in.
#
# [Kabir H-5] Every real deploy serves the SPA from nginx — deploy/hostinger/Caddyfile and
# deploy/utho/Caddyfile both `reverse_proxy frontend:80`, and that container's config is
# docker/nginx.conf.template. This file's syntax is only understood by Cloudflare Pages and
# Netlify, so it applies to preview deploys there and nowhere else.
#
# That gap was not theoretical: the per-path festival CSP below was added here in phase 6 and
# never reached a browser, so the sponsor Meta pixel was blocked in production the whole time the
# landing page advertised it as working. The real per-path policy now lives in the
# `map $uri $influora_csp` block in docker/nginx.conf.template.
#
# KEEP THE TWO IN SYNC. If you change a CSP directive here, change it there — and note that the
# nginx one is the only one that matters. Do NOT "fix" a production CSP problem by editing this
# file; you will see no effect and conclude the wrong thing.
#
# 2026-09-12, GTM/Clarity/Meta-Pixel install: the googletagmanager.com, clarity.ms,
# connect.facebook.net and capi-automation S3 entries below were added to honour the
# keep-in-sync rule above, and the /festival-box/* block was removed (see the note further
# down). connect-src was deliberately NOT touched — this file's connect-src already carries a
# bare `https:`, so listing the analytics and Facebook ingest origins here would be theatre.
# The nginx template has no such blanket and does list them; that asymmetry is intended, not
# drift.
/*
  Content-Security-Policy: default-src 'self'; script-src 'self' https://checkout.razorpay.com https://*.googletagmanager.com https://*.clarity.ms https://connect.facebook.net https://capi-automation.s3.us-east-2.amazonaws.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https: http://localhost:* http://127.0.0.1:* ws: wss: https://api.razorpay.com https://lumberjack.razorpay.com; frame-src https://api.razorpay.com https://checkout.razorpay.com https://*.googletagmanager.com https://tagassistant.google.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  # microphone=(self) -- Meera's voice input (useVoiceInput -> getUserMedia) needs mic access
  # from this app's own origin. This was blanket-disabled (microphone=()), which would have
  # permanently broken voice input the moment this header actually took effect on a real deploy
  # (Netlify/Cloudflare Pages honor public/_headers; Vite's local dev server does not, which is
  # why this wasn't the cause of any mic bug reproduced against localhost).
  Permissions-Policy: geolocation=(), microphone=(self), camera=()

# T-FESTIVALBOX-0905 phase 6's /festival-box/* block was DELETED on 2026-09-12, mirroring the
# same deletion in docker/nginx.conf.template (the file that actually matters — see the warning
# at the top).
#
# It existed to give ONE marketing page connect.facebook.net while the rest of influora.in
# stayed free of Meta. Swapnil's 2026-09-12 ruling put GTM (GTM-K7LNG26G) on every route with
# its Meta Pixel expected to fire, so the sitewide /* block above had to permit Facebook anyway
# — at which point this block granted nothing the default did not already grant. A path-scoped
# block that scopes nothing is worse than no block: it reads like protection.
#
# To restore the scoping, do it in BOTH files: drop connect.facebook.net and the
# capi-automation S3 bucket from the sitewide value, then re-add a /festival-box/* block here
# carrying them. Changing this file alone changes nothing a browser will ever see.
