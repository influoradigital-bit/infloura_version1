# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/

# Environment variables
.env*.local

# Common ignores
node_modules
.next/
.DS_Store

# Lighthouse CI reports (generated by ci/lighthouse-meera.mjs)
ci/.lighthouse/
lighthouse-*.report.*

# Locally downloaded build tools (e.g. Apache Maven binary distribution)
.tools/

# JVM crash artifacts (hotspot dumps from local OOM/JIT crashes)
# Deliberately narrow: _archive/logs/*.log is tracked on purpose, so no blanket *.log here.
hs_err_pid*.log
replay_pid*.log
*.hprof

# Machine-specific build scratch (absolute local paths — never portable)
cp.txt
classpath.txt

# Vite build output
dist/

# TypeScript incremental build info
*.tsbuildinfo

# Test/dev-server output
playwright-report/
test-results/
influora-ai/uvicorn_*.log

# Docs-consolidation holding pen: superseded docs moved here out of the tree.
# Their content stays recoverable from git history at the old paths.
_to_delete/

# Local export/bundle artifacts
_export/
*.zip

# Agent run logs
.claude/scratchpad-*.log