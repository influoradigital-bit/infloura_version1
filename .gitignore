# v0 sandbox internal files
__v0_runtime_loader.js
__v0_devtools.tsx
__v0_jsx-dev-runtime.ts
.snowflake/
.v0-trash/
.vercel/

# Environment variables
.env*.local

# Common ignores
node_modules
.next/
.DS_Store

# Lighthouse CI reports (generated by ci/lighthouse-meera.mjs)
ci/.lighthouse/
lighthouse-*.report.*

# Locally downloaded build tools (e.g. Apache Maven binary distribution)
.tools/

# JVM crash artifacts (hotspot dumps from local OOM/JIT crashes)
# Deliberately narrow: _archive/logs/*.log is tracked on purpose, so no blanket *.log here.
hs_err_pid*.log
replay_pid*.log
*.hprof

# Machine-specific build scratch (absolute local paths — never portable)
cp.txt
classpath.txt

# Vite build output
dist/

# TypeScript incremental build info
*.tsbuildinfo

# Test/dev-server output
playwright-report/
test-results/
influora-ai/uvicorn_*.log

# Docs-consolidation holding pen: superseded docs moved here out of the tree.
# Their content stays recoverable from git history at the old paths.
_to_delete/

# Local export/bundle artifacts
_export/
*.zip

# Agent run logs
.claude/scratchpad-*.log
# Agent git worktrees (throwaway parallel checkouts — never commit)
.claude/worktrees/

# Local env with secrets — never commit (use .env.example as the template)
.env.unix
influora-api/.env.unix

# Root-level build/dev logs (transient)
/*.log

# Python bytecode caches
__pycache__/
*.pyc

# Live infra access + credentials — never commit
deploy/hostinger/ACCESS-GUIDE.md

# graphify knowledge-graph output (derived, 100MB+) — never commit
graphify-out/
src/graphify-out/

# proof-os derived graph blobs (ledger/journal/gates stay trackable if desired)
.proof-os/graph*.json
.proof-os/*.bak.json
.proof-os/.runtime/

# extracted plugin copies — not project source
proof-os-0.1.3/
proof-os-0.1.8/

# Production env secrets — currently TRACKED in history; still needs
# `git rm --cached .env.production` + secret rotation to fully remediate
.env.production

# proof-os audit reports contain extracted secret-shaped strings — never commit them
.proof-os/_archive/**/gitleaks.json
.proof-os/tasks/**/gitleaks.json
